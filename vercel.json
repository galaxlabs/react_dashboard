{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://crm.galaxylabs.online/api/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options",        "value": "DENY"    },
        { "key": "Referrer-Policy",        "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "env": {
    "VITE_FRAPPE_BASE_URL": "https://crm.galaxylabs.online"
  },
  "build": {
    "env": {
      "VITE_FRAPPE_BASE_URL": "https://crm.galaxylabs.online"
    }
  }
}
